# 배포 도메인 — 끝 슬래시(/) 없이 입력
# 이 값이 없으면 sitemap.xml, robots.txt, canonical URL 이 모두 localhost 로 나가
# 구글/네이버 검색 색인이 정상 동작하지 않습니다.
#
# 사용 방법:
#   1. 이 파일을 복사해 .env.local 로 이름을 바꾸고
#   2. 아래 값을 실제 도메인으로 변경하세요.
#   3. Vercel 배포라면 Project Settings → Environment Variables 에서도 동일하게 설정하세요.
NEXT_PUBLIC_SITE_URL=https://child-rearing.vercel.app/

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://child-rearing.vercel.app/
