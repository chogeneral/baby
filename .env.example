# =============================================================================
# Vercel / 로컬 공통: 이 파일을 복사해 .env.local 로 쓰거나,
# Vercel 대시보드 Settings → Environment Variables 에 동일 키로 등록하세요.
# (값은 실제 키·URL로 바꿉니다. 이 저장소에는 비밀 값을 커밋하지 마세요.)
# =============================================================================

# --- Supabase (필수) — 클라이언트/서버에서 DB·인증에 사용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 공개 URL (배포 후 반드시 실제 URL로)
# Vercel 기본: https://프로젝트명.vercel.app (끝 슬래시 없음)
# 아이디/비밀번호 찾기 메일에 들어가는 링크의 기준이 됩니다.
NEXT_PUBLIC_BASE_URL=
# SEO·메타데이터(sitemap, robots)용. 비우면 getSiteUrl()이 VERCEL_URL로 보완됩니다.
# 커스텀 도메인 쓰면 https://example.com 처럼 정확히 맞추는 것이 좋습니다.
NEXT_PUBLIC_SITE_URL=

# --- 이메일 (문의, 아이디 찾기, 비밀번호 찾기) — 없으면 해당 API가 동작하지 않을 수 있음
MAIL_USER=
MAIL_PASS=

# --- 카카오: 지도(JS 키), 근처 장소 API(REST 키는 서버 전용, NEXT_PUBLIC 붙이지 않음)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=

# --- 토큰 서명(운영 시 반드시 임의의 긴 문자열로 설정; 기본값 사용 금지)
FIND_ID_SECRET=
RESET_PASSWORD_SECRET=
